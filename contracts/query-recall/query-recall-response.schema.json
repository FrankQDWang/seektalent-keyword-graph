{
  "$defs": {
    "OptimizedQueryTerm": {
      "additionalProperties": false,
      "description": "Ordered term-pool item emitted by query recall optimization.",
      "properties": {
        "action": {
          "enum": [
            "keep",
            "downrank",
            "replace",
            "add_alias_probe",
            "add_precision_companion",
            "score_only",
            "fallback"
          ],
          "title": "Action",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "query_mode": {
          "enum": [
            "keyword",
            "exact",
            "phrase",
            "boolean"
          ],
          "title": "Query Mode",
          "type": "string"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recall_bucket": {
          "enum": [
            "healthy",
            "too_wide",
            "too_narrow",
            "zero",
            "stale",
            "unknown"
          ],
          "title": "Recall Bucket",
          "type": "string"
        },
        "source_query_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Query Text"
        }
      },
      "required": [
        "query_text",
        "query_mode",
        "action",
        "rank",
        "provider",
        "recall_bucket",
        "reason"
      ],
      "title": "OptimizedQueryTerm",
      "type": "object"
    },
    "QueryRecallAlternative": {
      "additionalProperties": false,
      "description": "Graph-backed alternative candidate and optional provider observation.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryRecallObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query_mode": {
          "enum": [
            "keyword",
            "exact",
            "phrase",
            "boolean"
          ],
          "title": "Query Mode",
          "type": "string"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "relation_type": {
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "source_concept_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Concept Id"
        },
        "source_surface_id": {
          "minLength": 1,
          "title": "Source Surface Id",
          "type": "string"
        },
        "surface_id": {
          "minLength": 1,
          "title": "Surface Id",
          "type": "string"
        },
        "target_surface_id": {
          "minLength": 1,
          "title": "Target Surface Id",
          "type": "string"
        }
      },
      "required": [
        "query_text",
        "surface_id",
        "query_mode",
        "relation_type",
        "confidence",
        "source_surface_id",
        "target_surface_id",
        "evidence_type"
      ],
      "title": "QueryRecallAlternative",
      "type": "object"
    },
    "QueryRecallLineage": {
      "additionalProperties": false,
      "description": "Stable provenance for deterministic replay and debugging.",
      "properties": {
        "input_hash": {
          "minLength": 1,
          "title": "Input Hash",
          "type": "string"
        },
        "provider_sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Provider Sources",
          "type": "array"
        },
        "selection_policy_version": {
          "const": "policy-v1",
          "title": "Selection Policy Version",
          "type": "string"
        },
        "snapshot_schema_version": {
          "const": "snapshot-v1",
          "title": "Snapshot Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "input_hash",
        "snapshot_schema_version",
        "selection_policy_version",
        "provider_sources",
        "source_refs"
      ],
      "title": "QueryRecallLineage",
      "type": "object"
    },
    "QueryRecallObservation": {
      "additionalProperties": false,
      "description": "Provider-specific recall evidence selected from the runtime snapshot.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "minLength": 1,
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_api_version": {
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "query_hash": {
          "minLength": 1,
          "title": "Query Hash",
          "type": "string"
        },
        "query_mode": {
          "enum": [
            "keyword",
            "exact",
            "phrase",
            "boolean"
          ],
          "title": "Query Mode",
          "type": "string"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "recall_bucket": {
          "enum": [
            "healthy",
            "too_wide",
            "too_narrow",
            "zero",
            "stale",
            "unknown"
          ],
          "title": "Recall Bucket",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "rate_limited",
            "server_error",
            "network_error",
            "auth_error",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "surface_id": {
          "minLength": 1,
          "title": "Surface Id",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "observation_id",
        "provider",
        "surface_id",
        "query_text",
        "query_hash",
        "query_mode",
        "status",
        "observed_at",
        "recall_bucket",
        "provider_api_version"
      ],
      "title": "QueryRecallObservation",
      "type": "object"
    },
    "QueryRecallRecommendation": {
      "additionalProperties": false,
      "description": "A concrete term-pool action with provider recall evidence.",
      "properties": {
        "action": {
          "enum": [
            "keep",
            "downrank",
            "replace",
            "add_alias_probe",
            "add_precision_companion",
            "score_only",
            "fallback"
          ],
          "title": "Action",
          "type": "string"
        },
        "evidence_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Observation Ids",
          "type": "array"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "query_text": {
          "minLength": 1,
          "title": "Query Text",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "healthy_recall",
            "zero_recall",
            "too_wide_recall",
            "too_narrow_recall",
            "stale_observation",
            "unknown_observation",
            "no_match",
            "policy_blocked"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "recommended_query_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Query Text"
        }
      },
      "required": [
        "action",
        "query_text",
        "reason_code",
        "reason",
        "provider"
      ],
      "title": "QueryRecallRecommendation",
      "type": "object"
    },
    "QueryRecallWarning": {
      "additionalProperties": false,
      "description": "Consumer-visible provider recall warning.",
      "properties": {
        "code": {
          "enum": [
            "unsupported_provider",
            "no_match",
            "matched_without_observation",
            "zero_recall",
            "too_wide_recall",
            "too_narrow_recall",
            "stale_observation",
            "unknown_observation",
            "fallback"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "query_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Text"
        }
      },
      "required": [
        "code",
        "message",
        "provider"
      ],
      "title": "QueryRecallWarning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Keyword graph query recall analysis response.",
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/QueryRecallAlternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "input_observations": {
      "items": {
        "$ref": "#/$defs/QueryRecallObservation"
      },
      "title": "Input Observations",
      "type": "array"
    },
    "kg_snapshot_id": {
      "minLength": 1,
      "title": "Kg Snapshot Id",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/QueryRecallLineage"
    },
    "optimized_terms": {
      "items": {
        "$ref": "#/$defs/OptimizedQueryTerm"
      },
      "title": "Optimized Terms",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/QueryRecallRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "query-recall-response-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_policy_version": {
      "const": "policy-v1",
      "title": "Selection Policy Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/QueryRecallWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "kg_snapshot_id",
    "selection_policy_version",
    "input_observations",
    "alternatives",
    "recommendations",
    "warnings",
    "optimized_terms",
    "lineage"
  ],
  "title": "QueryRecallResponse",
  "type": "object"
}
