# SeekTalent Keyword Graph local environment template
#
# Production consumers normally do not need this file. In prod mode the package
# opens the runtime snapshot bundled inside the installed wheel.
#
# Use dev mode only for local builder/probe/debug work, for example when opening
# a freshly built snapshot before it is packaged into a release wheel.

###############################################################################
# Runtime mode
###############################################################################

# prod: default user/SeekTalent mode. Reads the bundled package snapshot.
# dev: internal build/probe/debug mode. Requires an explicit snapshot override.
SEEKTALENT_KEYWORD_GRAPH_MODE=prod

# Runtime enable switch. If false, consumers should fail open to the legacy path.
SEEKTALENT_KEYWORD_GRAPH_ENABLED=true

# Optional dev/operator override. Leave empty in normal prod installs.
SEEKTALENT_KEYWORD_GRAPH_SNAPSHOT_PATH=
SEEKTALENT_KEYWORD_GRAPH_MANIFEST_PATH=

# Optional deployment guard. If set, the opened snapshot should match this id.
SEEKTALENT_KEYWORD_GRAPH_SNAPSHOT_ID=

# Runtime defaults used when the caller does not pass these values explicitly.
SEEKTALENT_KEYWORD_GRAPH_DEFAULT_PROVIDER=cts
SEEKTALENT_KEYWORD_GRAPH_MAX_BUNDLES=5
SEEKTALENT_KEYWORD_GRAPH_MAX_ALTERNATIVES=5
SEEKTALENT_KEYWORD_GRAPH_FAIL_OPEN=true

###############################################################################
# Internal provider probe settings
###############################################################################

# These are for internal builder/probe jobs only. Runtime code must not read
# KEYWORD_GRAPH_CTS_* and must never call live providers.
KEYWORD_GRAPH_CTS_BASE_URL=
KEYWORD_GRAPH_CTS_TENANT_KEY=
KEYWORD_GRAPH_CTS_TENANT_SECRET=
KEYWORD_GRAPH_CTS_API_VERSION=v1
KEYWORD_GRAPH_CTS_REAL_GATE_FILE=/private/tmp/keyword-graph-real-cts.gate
KEYWORD_GRAPH_CTS_PROBE_MAX_RPS=1
KEYWORD_GRAPH_CTS_PROBE_MAX_CONCURRENCY=1
KEYWORD_GRAPH_CTS_PROBE_WINDOW_START=09:00
KEYWORD_GRAPH_CTS_PROBE_WINDOW_END=21:00
KEYWORD_GRAPH_CTS_PROBE_TIMEZONE=Asia/Shanghai
